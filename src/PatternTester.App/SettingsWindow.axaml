<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        
        xmlns:vm="using:PatternTester.App.ViewModels" 
        x:Class="PatternTester.App.SettingsWindow" 
        Icon="avares://PatternTester.App/Assets/icon.png"
        x:DataType="vm:MainWindowViewModel" 
        Title="{DynamicResource Settings.Title}"
  
        Width="520"
        Height="450"
        MinWidth="480"
        MinHeight="400">

	<Window.Styles>

		<!-- Header dei tab e contenuto di RadioButton/CheckBox/ComboBox
		     non sono TextBlock diretti nell'XAML (vengono renderizzati
		     dai template interni di quei controlli): la regola globale
		     su TextBlock in Theme.axaml non li raggiunge in modo
		     affidabile, quindi qui impostiamo esplicitamente la stessa
		     dimensione (13px) sui controlli stessi. -->
		<Style Selector="TabItem">
			<Setter Property="FontSize" Value="13" />
		</Style>

		<Style Selector="RadioButton">
			<Setter Property="FontSize" Value="13" />
		</Style>

		<Style Selector="CheckBox">
			<Setter Property="FontSize" Value="13" />
		</Style>

		<Style Selector="ComboBox">
			<Setter Property="FontSize" Value="13" />
		</Style>

		<Style Selector="ComboBoxItem">
			<Setter Property="FontSize" Value="13" />
		</Style>

		<Style Selector="ListBoxItem">
			<Setter Property="Padding" Value="0" />
			<Setter Property="Margin" Value="0" />
			<Setter Property="Background" Value="Transparent" />
		</Style>

		<Style Selector="ListBoxItem:pointerover">
			<Setter Property="Background" Value="#D8D8D8" />
		</Style>

		<Style Selector="ListBoxItem:selected">
			<Setter Property="Background" Value="#BDBDBD" />
			<Setter Property="BorderBrush" Value="#606060" />
		</Style>

	</Window.Styles>

    <Grid Margin="18"
          RowDefinitions="Auto,*,Auto"
          RowSpacing="16">

        <TextBlock Grid.Row="0"
                   Text="{DynamicResource Settings.Title}"
                   FontSize="20"
                   FontWeight="SemiBold" />

        <TabControl Grid.Row="1">

            <!-- ASPETTO -->
            <TabItem Header="{DynamicResource Settings.Appearance}">
                <ScrollViewer>
                    <StackPanel Margin="12" Spacing="10">
                        <TextBlock Text="{DynamicResource Settings.Theme}"
                                   Opacity="0.75" />

                        <RadioButton Content="{DynamicResource Settings.ThemeDark}"
                                     GroupName="Theme"
                                     IsChecked="{Binding UseDarkTheme}" />

                        <RadioButton Content="{DynamicResource Settings.ThemeLight}"
                                     GroupName="Theme"
                                     IsChecked="{Binding UseLightTheme}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- AVVIO -->
            <TabItem Header="{DynamicResource Settings.Startup}">
                <ScrollViewer>
                    <StackPanel Margin="12" Spacing="10">
                        <TextBlock Text="{DynamicResource Settings.StartupConfiguration}"
                                   Opacity="0.75" />

						<RadioButton Content="{DynamicResource Settings.UseLastConfiguration}"
									 GroupName="StartupMode"
									 IsChecked="{Binding StartupUseLast}" />

						<RadioButton Content="{DynamicResource Settings.UseDefaults}"
									 GroupName="StartupMode"
									 IsChecked="{Binding StartupUseDefaults}" />

						<CheckBox Content="{DynamicResource Settings.AutoShowPattern}"
								  IsChecked="{Binding Settings.AutoShowPattern}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- VALORI PREDEFINITI -->
			<TabItem Header="{DynamicResource Settings.DefaultValues}">
                <ScrollViewer>
				    <Grid Margin="12"
					      ColumnDefinitions="*,120"
					      RowDefinitions="Auto,Auto,Auto,Auto,Auto"
					      RowSpacing="10"
					      ColumnSpacing="12">

					    <TextBlock Grid.Row="0"
						           Text="{DynamicResource Settings.Pattern}"
						           VerticalAlignment="Center" />

					    <ComboBox Grid.Row="0"
						          Grid.Column="1"
						          ItemsSource="{Binding PatternNames}"
						          SelectedIndex="{Binding Settings.DefaultPatternIndex}" />

					    <TextBlock Grid.Row="1"
						           Text="{DynamicResource Settings.Monitor}"
						           VerticalAlignment="Top" />

					    <ListBox Grid.Row="1"
						         Grid.Column="1"
						         ItemsSource="{Binding MonitorOptions}"
						         SelectedItem="{Binding Settings.DefaultMonitor}"
						         Background="Transparent"
						         BorderThickness="0"
						         Padding="0">

						    <ListBox.ItemsPanel>
							    <ItemsPanelTemplate>
								    <WrapPanel Orientation="Horizontal"
									           ItemWidth="90"
									           ItemHeight="65" />
							    </ItemsPanelTemplate>
						    </ListBox.ItemsPanel>

						    <ListBox.ItemTemplate>
							    <DataTemplate>
								    <Border Margin="4"
									        CornerRadius="5"
									        Background="#E4E4E4"
									        BorderBrush="#B8B8B8"
									        BorderThickness="1">

									    <TextBlock Text="{Binding StringFormat='{}{0:00}'}"
										           HorizontalAlignment="Center"
										           VerticalAlignment="Center"
										           FontSize="16"
										           FontWeight="SemiBold" />

								    </Border>
							    </DataTemplate>
						    </ListBox.ItemTemplate>

					    </ListBox>

					    <TextBlock Grid.Row="2"
						           Text="{DynamicResource Settings.Language}"
						           VerticalAlignment="Center" />

					    <ComboBox Grid.Row="2"
						          Grid.Column="1"
						          ItemsSource="{Binding LanguageOptions}"
						          SelectedItem="{Binding SelectedLanguage}"
						          Width="120">
						    <ComboBox.ItemTemplate>
							    <DataTemplate>
								    <TextBlock Text="{Binding DisplayName}" />
							    </DataTemplate>
						    </ComboBox.ItemTemplate>
					    </ComboBox>
					    <TextBlock Grid.Row="3"
						           Text="{DynamicResource Settings.Columns}"
						           VerticalAlignment="Center" />

					    <ComboBox Grid.Row="3"
						          Grid.Column="1"
						          ItemsSource="{Binding ScreenOptions}"
						          SelectedItem="{Binding Settings.DefaultHorizontalScreens}" />

					    <TextBlock Grid.Row="4"
						           Text="{DynamicResource Settings.Rows}"
						           VerticalAlignment="Center" />

					    <ComboBox Grid.Row="4"
						          Grid.Column="1"
						          ItemsSource="{Binding ScreenOptions}"
						          SelectedItem="{Binding Settings.DefaultVerticalScreens}" />

				    </Grid>
                </ScrollViewer>
			</TabItem>

            <!-- SALVATAGGIO -->
            <TabItem Header="{DynamicResource Settings.Saving}">
                <ScrollViewer>
                    <StackPanel Margin="12" Spacing="10">
                        <TextBlock Text="{DynamicResource Settings.SaveWhen}"
                                   Opacity="0.75" />

						<RadioButton Content="{DynamicResource Settings.SaveOnExit}"
									 GroupName="SaveMode"
									 IsChecked="{Binding SaveOnExit}" />

						<RadioButton Content="{DynamicResource Settings.SaveOnChange}"
									 GroupName="SaveMode"
									 IsChecked="{Binding SaveOnChange}" />

						<RadioButton Content="{DynamicResource Settings.SaveManually}"
									 GroupName="SaveMode"
									 IsChecked="{Binding SaveManual}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">

            <Button Content="{DynamicResource Settings.Cancel}"
                    Click="CancelClick" />

            <Button Content="{DynamicResource Settings.OK}"
                    Click="OkClick" />

        </StackPanel>

    </Grid>
</Window>
